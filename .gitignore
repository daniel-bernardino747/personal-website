/coverage

# next.js
/.next/
/out/

# production
/build

# career output and the Corpus moved to the private `career` repository
# (ADR-0013). Kept ignored so a stray copy here can never be committed to this
# public repository. `content/devlog/` still lives here until the devlog
# produces an entry.
/generated
/content

# misc
.DS_Store
*.pem

# agent-local settings — machine-specific paths, not shared configuration
.claude/settings.local.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*

# Build artefact for the Railway deploy (scripts/pack-deploy.mjs).
/deploy.tar
/.deploy-staging/

# raw training photos and videos for the Mindset card — heavy originals, never
# published. `npm run mindset` converts them into public/mindset/, which is.
/media/mindset/*
!/media/mindset/README.md

# local build logs
build_log.txt
